defs
  // role labels
  $ceo = chief executive officer
  $coo = chief operating officer
  $cto = chief technology officer
  $cfo = chief financial officer
  $chro = chief people officer
  $ciso = chief information security officer
  $vp = vice president
  $dir = director
  $mgr = manager
  $lead = team lead
  $snr = senior specialist
  $spc = specialist
  $ops = operations coordinator
  $analyst = analyst
  $engineer = engineer
  $architect = architect
  $admin = administrator
  $legal = legal counsel

  // icon aliases
  $icon-ceo = crown
  $icon-fin = hand-coins
  $icon-tech = cpu
  $icon-sec = shield
  $icon-people = users
  $icon-ops = goal
  $icon-data = chart-column
  $icon-research = microscope
  $icon-sales = presentation
  $icon-support = headset
  $icon-compliance = scale
  $icon-cannabis = cannabis

  // palette
  $clr-bg-exec = #f3e8ff
  $clr-border-exec = #6b21a8
  $clr-bg-tech = #e0f2fe
  $clr-border-tech = #0369a1
  $clr-bg-fin = #ecfdf3
  $clr-border-fin = #047857
  $clr-bg-ops = #fff7ed
  $clr-border-ops = #c2410c
  $clr-bg-sec = #fef2f2
  $clr-border-sec = #b91c1c
  $clr-bg-people = #eef2ff
  $clr-border-people = #3730a3
  $clr-bg-research = #f0fdf4
  $clr-border-research = #15803d
  $clr-bg-sales = #fff1f2
  $clr-border-sales = #be123c
  $clr-bg-support = #f8fafc
  $clr-border-support = #334155
  $clr-title = #475569

style
  .kind-department
    border-style: none
    background-color: transparent
    font-size: 16
    font-weight: 500

  .node
    icon-size: 15
    icon-pos: bottom-right
    icon-opacity: 0.55

  .node-name
    font-weight: 700

  .node-title
    color: $clr-title
    line-spacing: 1.22

  .role-chief-executive-officer
    background-color: $clr-bg-exec
    border-color: $clr-border-exec
    icon-color: $clr-border-exec
    icon: $icon-ceo

  .role-chief-operating-officer
    background-color: $clr-bg-ops
    border-color: $clr-border-ops
    icon-color: $clr-border-ops
    icon: $icon-ops

  .role-chief-technology-officer
    background-color: $clr-bg-tech
    border-color: $clr-border-tech
    icon-color: $clr-border-tech
    icon: $icon-tech

  .role-chief-financial-officer
    background-color: $clr-bg-fin
    border-color: $clr-border-fin
    icon-color: $clr-border-fin
    icon: $icon-fin

  .role-chief-people-officer
    background-color: $clr-bg-people
    border-color: $clr-border-people
    icon-color: $clr-border-people
    icon: $icon-people

  .role-chief-information-security-officer
    background-color: $clr-bg-sec
    border-color: $clr-border-sec
    icon-color: $clr-border-sec
    icon: $icon-sec

  .role-security-architect
    background-color: #fee2e2
    border-color: #b91c1c
    icon-color: #b91c1c

  .role-research-specialist
    background-color: $clr-bg-research
    border-color: $clr-border-research
    icon-color: $clr-border-research
    icon: $icon-research

  .role-sales-lead
    background-color: $clr-bg-sales
    border-color: $clr-border-sales
    icon-color: $clr-border-sales
    icon: $icon-sales

  .role-support-lead
    background-color: $clr-bg-support
    border-color: $clr-border-support
    icon-color: $clr-border-support
    icon: $icon-support

  .role-compliance-counsel
    background-color: #f1f5f9
    border-color: #475569
    icon-color: #475569
    icon: $icon-compliance

  .role-biotech-regulatory-specialist
    background-color: #fef3c7
    border-color: #b45309
    icon-color: #b45309
    icon: $icon-cannabis

config
  company: Aetherion Global Systems
  region: fictional-eu
  render-theme: enterprise
  page-size: a3
  layout-mode: hanging-both

